# ── Chatbot (Google Gemini) ──────────────────────────────────────────────
# Your Google AI Studio / Gemini API key. Lives ONLY on the server — it is
# never exposed to the browser. Required for the assistant to work.
GEMINI_API_KEY=

# Optional: which Gemini model to use (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Optional: server port (DigitalOcean App Platform sets this automatically)
PORT=8080

# Optional: CORS origin if the API is served from a different host than the site
# (leave unset for same-origin deployments)
# ALLOWED_ORIGIN=https://your-domain.com

# ── Frontend (build-time) ────────────────────────────────────────────────
# Where the browser sends chat + translate requests. Defaults are same-origin.
# Only change these if the proxy lives on a separate domain.
# VITE_CHAT_ENDPOINT=/api/chat
# VITE_TRANSLATE_ENDPOINT=/api/translate
