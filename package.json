{
  "name": "engineered-reality-portfolio",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "description": "ENGINEERED REALITY \u2014 cinematic portfolio for Muhammad Owais Iqbal Malik, Embedded Systems & IoT Engineer",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "translate": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs scripts/translate.mts",
    "og": "node scripts/render-og.mjs",
    "photos": "node scripts/prepare-photos.mjs",
    "fallback": "node scripts/render-fallback.mjs",
    "translate:check": "node node_modules/tsx/dist/cli.mjs scripts/translate.mts --check",
    "perf": "node scripts/perf.mjs",
    "check:camera": "node scripts/check-camera.mjs && node scripts/framecheck.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "framer-motion": "^11.11.9",
    "gsap": "^3.12.5",
    "lenis": "^1.1.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "sass": "^1.79.5",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
